<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DafnyDir>../../dafny/Binaries</DafnyDir>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- ============================= -->
  <!-- Dafny + Boogie assemblies     -->
  <!-- ============================= -->
  <ItemGroup>
    <Reference Include="Dafny">
      <HintPath>$(DafnyDir)/Dafny.dll</HintPath>
    </Reference>
    <Reference Include="DafnyCore">
      <HintPath>$(DafnyDir)/DafnyCore.dll</HintPath>
    </Reference>
    <Reference Include="DafnyDriver">
      <HintPath>$(DafnyDir)/DafnyDriver.dll</HintPath>
    </Reference>
    <Reference Include="DafnyLanguageServer">    <!-- Add if needed -->
      <HintPath>$(DafnyDir)/DafnyLanguageServer.dll</HintPath>
    </Reference>

 <Reference Include="Boogie.Core">
      <HintPath>$(DafnyDir)/Boogie.Core.dll</HintPath>
    </Reference>

    <Reference Include="Boogie.VCGeneration">
      <HintPath>$(DafnyDir)/Boogie.VCGeneration.dll</HintPath>
    </Reference>

    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>$(DafnyDir)/Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
    </Reference>

    <Reference Include="Boogie.Provers.SMTLib">
      <HintPath>$(DafnyDir)/Boogie.Provers.SMTLib.dll</HintPath>
    </Reference>

    <Reference Include="Boogie.Model">
      <HintPath>$(DafnyDir)/Boogie.Model.dll</HintPath>
    </Reference>

    <Reference Include="Boogie.BaseTypes">
      <HintPath>$(DafnyDir)/Boogie.BaseTypes.dll</HintPath>
    </Reference>
    <!-- Other Boogie references... -->
  </ItemGroup>

  <!-- ============================= -->
  <!-- Runtime files                 -->
  <!-- ============================= -->
  <ItemGroup>
    <None Include="$(DafnyDir)/DafnyPrelude.bpl">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="$(DafnyDir)/DafnyStandardLibraries*.doo">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- ============================= -->
  <!-- NuGet packages                -->
  <!-- ============================= -->
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="Microsoft.Z3" Version="4.12.2" />
    <PackageReference Include="System.Collections.Immutable" Version="8.0.0" />
  </ItemGroup>

</Project>